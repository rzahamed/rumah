APP_NAME="CMS Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# --- Host architecture (all required; env-driven; fail-closed) --------------
# APP_URL and PUBLIC_APP_URL must both point at the PUBLIC site host.
# ADMIN_DOMAIN is the dedicated admin host; the Filament panel is mounted there
# at the ROOT path (https://admin.<domain>/login). There is no /admin fallback.
APP_URL=http://basecms.test
PUBLIC_APP_URL=http://basecms.test
ADMIN_APP_URL=http://admin.basecms.test
ADMIN_DOMAIN=admin.basecms.test

# --- Localization ----------------------------------------------------------
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
SUPPORTED_LOCALES=en,ar
RTL_LOCALES=ar

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database — PostgreSQL ONLY (separate DB + restricted role per client) --
# Provisioning is explicit — see README. Tests never use this database:
# phpunit.xml pins the dedicated *_testing database with force="true", and a
# fail-fast guard refuses anything not named *_testing/*_test. A local test
# password, if required, belongs in the git-ignored .env.testing.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=basecms
DB_USERNAME=basecms_app
DB_PASSWORD=

# --- Session — host-only cookie --------------------------------------------
# Do NOT set a leading-dot SESSION_DOMAIN unless cross-subdomain auth is
# explicitly required. Admin auth lives only on the admin host.
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_COOKIE=basecms-session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# --- Cache + Redis ---------------------------------------------------------
# Per-project isolation on a shared Redis is EXPLICIT: every client repo
# replaces "basecms" with its own unique identifier across the session cookie,
# cache/Redis key prefixes and queue names below — visible and auditable, not
# reliant on framework APP_NAME-derived default naming.
CACHE_STORE=redis
CACHE_PREFIX=basecms-cache-
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=basecms-database-
REDIS_QUEUE=basecms-default

# --- Admin invitations ------------------------------------------------------
# Days an invitation link stays valid (single-use, stored only as a hash).
INVITATION_EXPIRY_DAYS=7

# --- Mail — Resend in production, log locally ------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# --- Media disk (env-driven public/private arrangement) --------------------
# 'public' (local) for development; a GCS disk (e.g. gcs_public_website) in
# production — no code change.
MEDIA_DISK=public

# --- Google Cloud Storage ---------------------------------------------------
# Empty GOOGLE_CLOUD_KEY_FILE = Application Default Credentials; set a
# key-file path only when explicitly needed. Buckets use Uniform
# Bucket-Level Access: public exposure comes from bucket IAM, never
# per-object ACLs. GOOGLE_CLOUD_SIGNING_SERVICE_ACCOUNT is reserved for
# signed-URL generation (not yet consumed by code).
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_KEY_FILE=
GOOGLE_CLOUD_SIGNING_SERVICE_ACCOUNT=
GOOGLE_CLOUD_STORAGE_PATH_PREFIX=dev

# Public website assets (gcs_public_website disk). PUBLIC_ASSET_URL, when
# set, must be the base-through-bucket URL (e.g. a CDN host bound to the
# bucket) WITHOUT the prefix — the adapter appends "prefix/stored-path"
# itself. Otherwise the URL is derived from PUBLIC_ASSET_BASE_URL + bucket.
PUBLIC_ASSET_BUCKET=
PUBLIC_ASSET_PREFIX=public-website
PUBLIC_ASSET_BASE_URL=https://storage.googleapis.com
PUBLIC_ASSET_URL=

# --- Cal.com booking --------------------------------------------------------
# Hosts allowed for the super-admin Cal.com booking URL setting (comma
# separated; exact host or any subdomain). Extend for white-label Cal
# domains, e.g. "cal.com,book.example-client.com".
CAL_ALLOWED_HOSTS=cal.com

# --- Blog featured images ---------------------------------------------------
# 'public' (local) for development; production sets
# BLOG_FEATURED_DISK=gcs_public_website (public website assets bucket).
# BLOG_FEATURED_DIR is the directory within the disk.
BLOG_FEATURED_DISK=public
BLOG_FEATURED_DIR=blogs

VITE_APP_NAME="${APP_NAME}"
